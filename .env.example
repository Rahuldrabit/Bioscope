# Local/demo profile only. Never place production secrets in this file.
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=postgresql+asyncpg://bioscope:bioscope@localhost:5432/bioscope
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=bioscope-private
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
API_CORS_ORIGINS=["http://localhost:3000"]
ENABLE_EXTERNAL_SOURCES=false
ENABLE_SKIN_IMAGE_UPLOAD=false
ENABLE_NUMERIC_CONFIDENCE=false
MAX_UPLOAD_MB=10
ASSET_RETENTION_DAYS=7
NEXT_PUBLIC_API_URL=http://localhost:8000
LOCAL_ASSET_DIR=data/local/assets
